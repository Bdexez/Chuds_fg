    def _hero_state(self):
        """(style, eyebrow, title, subtitle, button label or None, button style)."""
        if not self.installed and capture_binary() is None:
            return ("warn", tr("À INSTALLER"), tr("La couche Vulkan n'est pas installée"),
                    tr("Installe-la : elle se charge ensuite toute seule dans tes jeux, sans option Steam."),
                    tr("Installer"), "")
        if self.opt.without_panel:
            return ("on", tr("MODE JEU"), tr("Actif dans tous les jeux"),
                    tr("Chaque jeu génère dès son lancement, même panneau fermé (Avancé › Système)."),
                    tr("Désactiver"), "stop")
