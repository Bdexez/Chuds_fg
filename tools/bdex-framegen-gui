        self._add_view(self._build_simple(), "simple", tr("Simple"), "starred-symbolic")
        self._add_view(self._build_advanced(), "advanced", tr("Avancé"), "preferences-system-symbolic")
        if read_ui_state().get("page") == "advanced":
            self.stack.set_visible_child_name("advanced")
        self.stack.connect("notify::visible-child-name", self._on_page)
        self._shortcuts()
        if HAVE_ADW and hasattr(Adw._adw, "Breakpoint"):
            try:   # (narrow windows, Steam Deck in portrait: no sidebar, the search stays)
                bp = Adw._adw.Breakpoint.new(Adw._adw.BreakpointCondition.parse("max-width: 640sp"))
                bp.add_setter(self.adv_side, "visible", False)
                self.add_breakpoint(bp)
            except (TypeError, GLib.Error):
                pass

        self._loading = False
        self.refresh()
        # Every game armed, the session decides (require_app): written once.
        if self.cfg.glob.get("require_app") not in ("0", "1") or self.cfg.glob.get("enabled") != "1":
            self.save()
        try:
            write_session(0)   # open: upscaling applies to games started from now
        except OSError as e:
            self.toast(tr(f"Session impossible : {e}"))
        self._refresh_games()
        GLib.timeout_add_seconds(1, self._beat)
        GLib.timeout_add_seconds(2, self._poll_games)
        GLib.idle_add(self._refresh_sandboxes)
        self.connect("close-request", self._on_close)
        if read_calibration() is None and calibrate_binary():
            GLib.timeout_add(1500, lambda: self.calibrate() and False)

