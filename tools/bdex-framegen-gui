    def _refresh_hero(self):
        style, eyebrow, title, sub, btn, btn_style = self._hero_state()
        for c in ("on", "idle", "warn"):
            self.hero.remove_css_class(c)
        if style != "ready":
            self.hero.add_css_class(style)
        self.hero_eyebrow.set_text(eyebrow)
        self.hero_title.set_text(title)
        self.hero_sub.set_text(sub)
        self.hero_btn.set_label(btn)
        (self.hero_btn.add_css_class if btn_style == "stop" else self.hero_btn.remove_css_class)("stop")
        self.hero_btn.set_sensitive(style != "idle")
        generating = self.target is not None and not self.opt.without_panel
        self.hero_pause.set_visible(generating and self.opt.generate)
        self.hero_pause.set_label(tr("Reprendre") if self.opt.paused else tr("Pause"))
        self.hero_stats.set_visible(generating)
        if generating:
            self._refresh_stats()

    def _refresh_stats(self):
        if self.capture_proc is not None:
            entries = read_status(self.capture_proc.pid)
        else:
            entries = read_status(self.target[0]) if self.target and self.target[0] else []
        sw = next((e for e in entries if e.get("kind") in ("swapchain", "capture")
                   and e.get("state") in ("generating", "paused")), None)
        values = ["—"] * 4
        if sw:
            try:
                values[0] = f"{float(sw.get('game_fps', 0)):.0f}"
                values[1] = f"{float(sw.get('output_fps', 0)):.0f}"
                values[2] = f"×{sw.get('multiplier', '?')}"
                lat = float(sw.get("latency_ms", -1))
                values[3] = f"{lat:.0f} ms" if lat >= 0 else "—"
            except ValueError:
                pass
        for lab, v in zip(self.stat_values, values):
            lab.set_text(v)

    def _refresh_simple(self):
        o = self.opt
        v = mult_value(o)
        self.seg_mult.set(v, mult_label(v))
        self.mult_sub.set_text(mult_explain(v, self.hz))
        limit = limit_value(o.values.get("fps_limit", "0"))
        self.limit_switch.set_active(limit != "0")
        self.limit_row.set_visible(limit != "0")
        self.seg_limit.set(limit if limit in self.seg_limit.buttons else "", None)
        self.limit_spin.set_sensitive(limit != "auto")
        if limit not in ("0", "auto"):
            self.limit_adj.set_value(float(limit))
        self.limit_sub.set_text(limit_explain(limit, o, self.hz))
        self.seg_mode.set(o.mode, tr("Hybride") if o.mode == "hybrid" else None)
        self.mode_sub.set_text({
            "interpolate": tr("Fluidité : images interpolées entre deux images du jeu — la meilleure qualité, "
                              "un peu de latence en plus."),
            "extrapolate": tr("Réactivité : images prédites après chaque image du jeu — presque aucune latence "
                              "ajoutée, plus d'artefacts aux bords des objets."),
            "hybrid": tr("Hybride (réglé dans Avancé) : interpolées et prédites, latence divisée par 2 à 3 en ×3/×4.")
        }.get(o.mode, ""))
