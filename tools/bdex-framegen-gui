                sub = tr("Multiplicateur désactivé : aucune image générée")
            return "on", eyebrow, name, sub, tr("Arrêter"), "stop"
        if self.selected:
            return ("ready", tr("PRÊT"), self.shown(self.selected),
                    tr("Appuie sur Démarrer : la génération s'applique au jeu en cours."), tr("Démarrer"), "")
