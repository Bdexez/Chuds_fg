    def _categories(self):
        """[(id, title, description, icon, [Setting])] in the sidebar's order."""
        own = self._panel_settings()
        json_sections = {sid: (title, sub, opts) for sid, title, sub, _exp, opts in SECTIONS}
        icons = {"cadence": "power-profile-performance-symbolic", "motion": "find-location-symbolic",
                 "flow": "view-grid-symbolic", "experimental": "applications-science-symbolic",
                 "compat": "emblem-system-symbolic", "diagnostic": "utilities-terminal-symbolic"}

        def opts(sid):
            return [option_setting(o, self.opt) for o in json_sections.get(sid, ("", "", []))[2]]

        def section(sid):
            title, sub, _ = json_sections[sid]
            return sid, title, sub, icons.get(sid, "preferences-other-symbolic"), opts(sid)
        cats = [("generation", tr("Génération"), tr("Combien d'images, comment, et sur quel GPU."),
                 "media-playback-start-symbolic", own["generation"])]
        order = ["cadence", "motion", "flow", "experimental", "compat", "diagnostic"]
        order += [sid for sid in json_sections if sid not in order]
        for sid in order:
            if sid not in json_sections:
                continue
            cats.append(section(sid))
            if sid == "cadence":
                cats.append(("display", tr("Affichage"), tr("Compteur de FPS, mode de présentation, latence."),
                             "video-display-symbolic", own["display"]))
                cats.append(("upscale", "Upscaling", tr("Le jeu rend en résolution réduite, agrandie à l'affichage "
                                                        "(X11, Xwayland et Wayland natif)."),
                             "zoom-in-symbolic", own["upscale"]))
        cats.append(("system", tr("Système"), tr("Couche Vulkan, GPU, calibration, mode Jeu, diagnostic."),
                     "computer-symbolic", own["system"]))
        return cats

