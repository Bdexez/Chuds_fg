    def _refresh_system(self):
        self.status_row.set_subtitle(tr("Installée — chargée automatiquement dans tous les jeux Vulkan")
                                     if self.installed else
                                     tr("Non installée : sans elle, seule la capture de fenêtre fonctionne"))
        self.status_icon.set_from_icon_name("object-select-symbolic" if self.installed else "dialog-warning-symbolic")
        self.install_btn.set_visible(not self.installed)
        armed = self.selected is not None and any(e.get("kind") == "swapchain"
                                                  for e in self.games.get(self.selected[0], ("", []))[1])
        self.record_btn.set_sensitive(armed and not layer_replaced(self.selected[0]))
        self._refresh_always()

    def _refresh_always(self):
        """The selected game's « without the panel » switch, then the other
        games set so (each with « Retirer »)."""
        always = self.cfg.always_games()
        name = self.selected[1] if self.selected else None
        self.always_row.set_title(tr(f"Ce jeu : {self.shown(self.selected)}") if name else tr("Le jeu sélectionné"))
        self.always_row.set_subtitle(tr("Génère dès son lancement, panneau fermé") if name else
                                     tr("Choisis un jeu dans « Simple » (lancé une fois ici)"))
        self.always_row.set_active(name is not None and name.lower() in (a.lower() for a in always))
        self.always_row.set_sensitive(name is not None and not self.opt.without_panel)
        others = [g for g in always if name is None or g.lower() != name.lower()]
        if others == [r.get_title() for r in self.always_rows]:
            return
        for row in self.always_rows:
            self.always_group.remove(row)
        self.always_rows = []
        for game in others:
            row = Adw.ActionRow(title=game, subtitle=tr("Génère sans le panneau"))
            btn = Gtk.Button(label=tr("Retirer"), valign=Gtk.Align.CENTER)
            btn.connect("clicked", lambda _b, gname=game: self._set_always(gname, False))
            row.add_suffix(btn)
            self.always_group.add(row)
            self.always_rows.append(row)

    def _refresh_counts(self):
        total = 0
        for cid, c in self.cats.items():
            n = sum(1 for _g, rows in c["groups"] for r in rows if isinstance(r, SettingRow) and r.s.modified())
            total += n
            c["badge"].set_text(str(n))
            c["badge"].set_visible(n > 0)
        self.modified_label.set_text(tr(f"{total} réglage(s) modifié(s)") if total else
                                     tr("Tous les réglages sont par défaut"))
        self.reset_all_btn.set_sensitive(total > 0)

    def _on_search(self, entry):
        q = entry.get_text().strip().lower()
        words = q.split()
        any_match = False
        for c in self.cats.values():
            cat_match = False
            for g, rows in c["groups"]:
                g_match = False
                for r in rows:
                    ok = all(w in r.text for w in words)
                    r.row.set_visible(ok)
                    g_match |= ok
                if g is getattr(self, "always_group", None):
                    for row in self.always_rows:
                        row.set_visible(not words)
                g.set_visible(g_match)
                cat_match |= g_match
            c["head"].set_visible(cat_match)
            c["nav"].set_visible(cat_match)
            any_match |= cat_match
        self.no_match.set_visible(not any_match)
        if words:
            self.adv_scroll.get_vadjustment().set_value(0)

    def _y_of(self, widget):
        """The widget's vertical position in the advanced page's content."""
        if Graphene is not None and hasattr(widget, "compute_point"):
            ok, p = widget.compute_point(self.adv_content, Graphene.Point())
            return p.y if ok else None
        res = widget.translate_coordinates(self.adv_content, 0, 0)
        return res[-1] if res and res[0] else None

    def _on_nav(self, _list, row):
        if row is None or self._spy_quiet:
            return
        y = self._y_of(self.cats[row.cat]["head"])
        if y is not None:
            self._spy_quiet = True
            self.adv_scroll.get_vadjustment().set_value(max(0, y - 8))
            self._spy_quiet = False

    def _on_adv_scroll(self, adj):
        """The category being read, selected in the sidebar."""
        if self._spy_quiet:
            return
        top, current = adj.get_value() + 40, None
        if adj.get_value() + adj.get_page_size() >= adj.get_upper() - 2:
            current = next((cid for cid in reversed(list(self.cats)) if self.cats[cid]["head"].get_visible()), None)
        else:
            for cid, c in self.cats.items():
                if not c["head"].get_visible():
                    continue
                y = self._y_of(c["head"])
                if y is not None and y <= top:
                    current = cid
        if current and self.nav.get_selected_row() is not self.cats[current]["nav"]:
            self._spy_quiet = True
            self.nav.select_row(self.cats[current]["nav"])
            self._spy_quiet = False

    def on_reset_all(self, _btn):
        before = [(r.s, r.s.get()) for r in self.setting_rows if r.s.modified()]
        if not before:
            return
        for s, _v in before:
            s.put(s.default)
        self.changed()

        def undo():
            for s, v in before:
                s.put(v)
            self.changed()
        self.toast(tr(f"{len(before)} réglage(s) remis par défaut."), tr("Annuler"), undo)

    # == state <-> widgets ===================================================

    @contextlib.contextmanager
    def quiet(self):
        """Widgets set from the state, not by the user: their signals change nothing."""
        loading, self._loading = self._loading, True
        try:
            yield
        finally:
            self._loading = loading

    def refresh(self):
        """Every widget from Options."""
        with self.quiet():
            for r in self.setting_rows:
                r.load()
            self._refresh_simple()
            self._refresh_counts()
            self._refresh_system()
            self._refresh_hero()

    def changed(self):
        """An option changed in Options: written soon, both pages refreshed."""
        if self._loading:
            return
        self.refresh()
        if self.target and self.target[0] and (self.opt.method, self.opt.gpu) != self._target_key:
            GLib.idle_add(lambda: self._set_target(self.target) and False)   # (by the new method / GPU)
        self.save_soon()

    def save_soon(self):
        """A burst of changes (a spin held down) is one write: the games reload
        the file at each one."""
        if self._save_timer:
            GLib.source_remove(self._save_timer)
        self._save_timer = GLib.timeout_add(250, self._save_now)

    def _save_now(self):
        self._save_timer = 0
        self.save()
        return False

    def save(self):
        if self._save_timer:
            GLib.source_remove(self._save_timer)
            self._save_timer = 0
        # Re-read first: lines edited by hand while the panel is open
        # ([game] sections, unmanaged keys) must survive its next save.
        self.cfg = ConfigFile.load()
        self.opt.write_into(self.cfg.glob)
        try:
            self.cfg.write()
        except OSError as e:
            self.toast(tr(f"Échec de l'enregistrement : {e}"))
            return
        mirror_config()   # sandboxed games (Flatpak Steam...) read their own copy

    def toast(self, text, action=None, on_action=None):
        if HAVE_ADW and action:
            t = Adw._adw.Toast(title=text, use_markup=False, button_label=action)
            t.connect("button-clicked", lambda *_: on_action())
            self.toasts.add_toast(t)
            return
        self.toasts.add_toast(Adw.Toast.new(text))

    def warn(self, text):
        """A warning that stays until read (a dialog where GTK has one), the
        action going ahead behind it."""
        try:
            d = Gtk.AlertDialog(message=tr("Attention"), detail=text)
            d.show(self)
        except (AttributeError, TypeError):
            t = Adw.Toast.new(text)
            try:
                t.set_timeout(0)
            except AttributeError:
                pass
            self.toasts.add_toast(t)

    # == games, session ======================================================

    def _poll_games(self):
        self._refresh_games()
        return True

    def _refresh_games(self):
        detected = detect_games()
        read_running(keep={inner_pid(pid) for pid, _ in detected})   # drops what crashed games left
        games, seen = {}, set()
        for pid, name in sorted(detected, key=lambda g: g[1]):
            if name not in seen:
                seen.add(name)
                games[pid] = (name, read_status(pid))
        self.games = games
        if self.target and self.target[0] and self.target[0] not in games:   # the game has exited
            self._set_target(None)   # (a window picked for capture: its own end, see _beat)
        if self.selected and self.selected[0] not in games:
            self.selected = None
        if not self.selected and len(games) == 1:
            pid = next(iter(games))
            self.selected = (pid, games[pid][0])
        for pid in [p for p in self.game_rows if p not in games]:
            self.games_list.remove(self.game_rows.pop(pid).row)
        for pid, (name, entries) in games.items():
            row = self.game_rows.get(pid)
            if row is None:
                row = self.game_rows[pid] = GameRow(self, pid, name)
                self.shown_names[pid] = row.row.get_title()
                self.games_list.insert(row.row, len(self.game_rows) - 1)
            how = plan(entries, self.opt, capture_binary() is not None)
            row.update(entries, how, layer_replaced(pid), self.target is not None and self.target[0] == pid)
        self.games_empty.set_visible(not games)
        with self.quiet():
            for pid, row in self.game_rows.items():
                row.radio.set_active(self.selected is not None and self.selected[0] == pid)
            if self.selected is None:
                self.radio_anchor.set_active(True)
            self._refresh_system()
            self._refresh_hero()

    def on_pick(self, radio, game):
        if self._loading or not radio.get_active():
            return
        self.selected = game
        if self.target and self.target != game:
            self._set_target(game)   # generating: move it to the chosen game
        with self.quiet():
            self._refresh_system()
            self._refresh_hero()

    def _beat(self):
        if self.capture_proc is not None and self.capture_proc.poll() is not None:
            # the capture ended: the game closed, or it failed (capture.log)
            self.capture_proc = None
            self.target, self.target_how = None, None
            self.toast(tr("Capture terminée (journal : ~/.cache/bdex-framegen/capture.log)"))
            self._refresh_hero()
        try:
            layer = self.target and self.target_how and self.target_how[0] == "layer"
            write_session(self.target[0] if layer else 0)
        except OSError:
            pass
        if self.target:
            self._refresh_stats()
        return True

    def _on_close(self, *_):
        if self._save_timer:
            self.save()
        stop_capture(self.capture_proc)
        remove_session()       # the targeted game stops generating
        return False

    def _set_target(self, target, pick=False, wayland=False):
        """Generation for `target` (pid, name), or none: injection through the
        layer's session where plan() says so, else bdex-capture on the game's
        window (`pick`: on the next window clicked, any program)."""
        stop_capture(self.capture_proc)
        self.capture_proc = None
        how = None
        if target:
            how = ("capture", tr("capture (fenêtre choisie)")) if pick else \
                plan(read_status(target[0]), self.opt, capture_binary() is not None)
        if target and not pick:
            ac = game_anticheat(target[0], read_status(target[0]))
            if ac:
                self.warn(anticheat_warning(target[1], ac, how[0]))
        try:
            if target:
                self.save()   # the game reads the options shown here
            write_session(target[0] if target and how[0] == "layer" else 0)
            if how and how[0] == "capture":
                self.capture_proc = start_capture(0 if pick else inner_pid(target[0]), self.opt.gpu, wayland)
        except OSError as e:
            self.toast(tr(f"Échec : {e}"))
            target, how = None, None
        self.target = target
        self.target_how = how
        self._target_key = (self.opt.method, self.opt.gpu)
        self._refresh_hero()

    def on_hero_button(self, _btn):
        if not self.installed and capture_binary() is None:
            self.on_install(self.hero_btn)
            return
        if self.opt.without_panel:
            self.opt.without_panel = False
            self.changed()
            return
        self._set_target(None if self.target else self.selected)
        GLib.timeout_add(1500, lambda: self._refresh_games() and False)   # (the game's status follows)

    def on_pause(self, _btn):
        self.opt.paused = not self.opt.paused
        self.changed()

    def on_capture_wayland(self, _btn):
        self._set_target((0, tr("fenêtre Wayland")), pick=True, wayland=True)
        if self.capture_proc is not None:
            self.toast(tr("Choisis la fenêtre du jeu dans la fenêtre du bureau"))

    def on_capture_window(self, _btn):
        self._set_target((0, tr("fenêtre choisie")), pick=True)
        if self.capture_proc is not None:
            self.toast(tr("Clique sur la fenêtre du jeu"))

    def on_always(self, row, _param):
        if self._loading or not self.selected:
            return
        self._set_always(self.selected[1], row.get_active())

    def _set_always(self, name, on):
        self.save()                    # (re-reads the file: hand edits survive)
        self.cfg.set_always(name, on)
        try:
            self.cfg.write()
        except OSError as e:
            self.toast(tr(f"Échec de l'enregistrement : {e}"))
            return
        mirror_config()
        self.toast(tr(f"{name} : génère sans le panneau.") if on else tr(f"{name} : seulement avec « Démarrer »."))
        with self.quiet():
            self._refresh_always()

    # == tools ===============================================================

    def calibrate(self):
        self.cal_btn.set_sensitive(False)
        self.cal_row.set_subtitle(tr("Mesure en cours… (quelques secondes)"))

        def work():
            d = run_calibration()

            def done():
                self.cal_btn.set_sensitive(True)
                self.cal_apply.set_sensitive(d is not None)
                self.cal_row.set_subtitle(calibration_summary(d) if d else tr("La mesure a échoué"))
                return False
            GLib.idle_add(done)
        threading.Thread(target=work, daemon=True).start()

    def on_calibration_apply(self, _btn):
        d = read_calibration()
        if not d:
            return
        r = d["recommended"]
        self.opt.preset = r["preset"]
        self.opt.generate = True
        if not (self.opt.auto_mult or self.opt.adaptive):
            self.opt.multiplier = int(r["multiplier"])
        self.changed()
        self.toast(tr(f"Calibration appliquée : profil {r['preset']}, jusqu'à ×{r['multiplier']}"))

    def on_record(self, _btn):
        if not self.selected:
            return
        game = self.selected
        try:
            src = request_recording(game[0], game[1])
        except OSError as e:
            self.toast(tr(f"Enregistrement impossible : {e}"))
            return
        self.toast(tr(f"Enregistrement de {self.shown(game)}… (le jeu peut ralentir quelques secondes)"))
        start = time.monotonic()

        def wait():
            if os.path.isfile(os.path.join(src, "DONE")):
                def pack():
                    out = finish_recording(src)
                    GLib.idle_add(lambda: self.toast(tr(f"Enregistrement prêt : {out}")) and False)
                threading.Thread(target=pack, daemon=True).start()
                return False
            if time.monotonic() - start > 120:
                self.toast(tr("L'enregistrement n'a pas abouti (le jeu est-il armé ?)"))
                return False
            return True
        GLib.timeout_add(1000, wait)

    def on_report(self, _btn):
        path, url = write_report()
        if not path:
            self.toast(tr("Rapport impossible : bdex-framegen introuvable"))
            return
        self.toast(tr(f"Rapport écrit dans {path} — à joindre au formulaire"))
        if url:
            try:
                Gio.AppInfo.launch_default_for_uri(url, None)
            except GLib.Error:
                self.toast(tr("Ouvre le lien affiché par « bdex-framegen --issue-url »"))

    def on_copy(self, _btn):
        Gdk.Display.get_default().get_clipboard().set(self.opt.steam_string())
        self.toast(tr("Options Steam (équivalent par jeu) copiées."))

    def on_open_config(self, _btn):
        if self._save_timer:
            self.save()
        try:
            Gio.AppInfo.launch_default_for_uri(GLib.filename_to_uri(os.path.dirname(CONFIG_PATH), None), None)
        except GLib.Error:
            self.toast(CONFIG_PATH)

    def on_about(self, _btn):
        texts = dict(application_name="bdex-framegen", developer_name="Bdexez", application_icon="input-gaming-symbolic",
                     comments=tr("Génération d'images par flux optique pour les jeux Vulkan et Proton."))
        if HAVE_ADW and hasattr(Adw._adw, "AboutDialog"):
            Adw._adw.AboutDialog(**texts).present(self)
            return
        Gtk.AboutDialog(transient_for=self, modal=True, program_name="bdex-framegen", authors=["Bdexez"],
                        logo_icon_name="input-gaming-symbolic", comments=texts["comments"]).present()

    def on_install(self, btn):
        here = os.path.dirname(os.path.abspath(__file__))
        script = os.path.join(here, "install.sh")
        if not os.path.exists(script):
            self.toast(tr("tools/install.sh introuvable."))
            return
        btn.set_sensitive(False)
        btn.set_label(tr("Installation…"))
        self.toast(tr("Installation de la couche… (compilation, quelques instants)"))

        def run():
            try:
                p = subprocess.run(["bash", script], capture_output=True, text=True, timeout=900)
                ok, msg = p.returncode == 0, (p.stderr.strip().splitlines() or [""])[-1]
            except (OSError, subprocess.SubprocessError) as e:
                ok, msg = False, str(e)
            GLib.idle_add(self._install_done, btn, ok, msg)

        threading.Thread(target=run, daemon=True).start()

    def _install_done(self, btn, ok, msg):
        btn.set_sensitive(True)
        if ok:
            self.installed = True
            self.toast(tr("Couche installée. Lance ton jeu — c'est actif."))
        else:
            btn.set_label(tr("Réessayer"))
            self.toast(tr(f"Échec de l'installation : {msg}"))
        self.refresh()
        return False


