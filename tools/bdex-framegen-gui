                                 (how is not None and how[0] == "capture"))


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="bdex-framegen")
        self.set_default_size(1000, 780)
        self.cfg = ConfigFile.load()
        self.opt = Options()
        self.opt.load_from(self.cfg.glob)
        self._loading = True        # widgets being filled from Options: no save
        self._save_timer = 0
        self._spy_quiet = False
        self.installed = find_layer()[0]
        self.hz = display_hz()
        self.gpus = generation_gpus()
        if self.opt.gpu and not any(self.opt.gpu.lower() in n.lower() for n in self.gpus):
            self.gpus.append(self.opt.gpu)   # (chosen before, not seen now)
        self.target = None          # (pid, name) where « Démarrer » started the generation
        self.target_how = None      # ("layer" | "capture", why) for the target
        self.capture_proc = None    # bdex-capture, when the target is captured
        self._target_key = None     # (method, GPU) the target was started with
        self.selected = None        # (pid, name) chosen in « Choisis le jeu »
        self.game_rows = {}         # pid -> GameRow
        self.shown_names = {}       # pid -> the game's name as shown (display_name)
        self.games = {}             # pid -> (name, status entries)
        self.setting_rows = []
        self._last_limit = None     # the cap before « Limiter » was switched off
        self.radio_anchor = Gtk.CheckButton()   # (the radios' group; active: no game chosen)

        self.toasts = Adw.ToastOverlay()
        self.set_content(self.toasts)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.toasts.set_child(outer)

        self.stack = Adw.ViewStack() if HAVE_ADW else Gtk.Stack(
            transition_type=Gtk.StackTransitionType.CROSSFADE)
        header = Adw.HeaderBar()
        if HAVE_ADW:
            header.set_title_widget(Adw.ViewSwitcher(stack=self.stack, policy=Adw.ViewSwitcherPolicy.WIDE))
        else:
            header.set_title_widget(Gtk.StackSwitcher(stack=self.stack))
        header.pack_end(self._build_menu())
        if HAVE_ADW:
            outer.append(header)
        else:
            self.set_titlebar(header)
        outer.append(self.stack)
