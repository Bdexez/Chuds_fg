        self.hud_switch.set_active(o.hud > 0)
        self.summary.set_text(expected_summary(o, self.hz))

    # -- « Simple » handlers

    def _pick_mult(self, v):
        if self._loading:
            return
        set_mult(self.opt, v)
        self.changed()

    def _on_limit_switch(self, *_):
        if self._loading:
            return
        cur = limit_value(self.opt.values.get("fps_limit", "0"))
        if self.limit_switch.get_active() and cur == "0":
            self.opt.values["fps_limit"] = self._last_limit or limit_suggestion(self.opt, self.hz)
        elif not self.limit_switch.get_active() and cur != "0":
            self._last_limit = cur
            self.opt.values["fps_limit"] = "0"
        self.changed()

    def _pick_limit(self, v):
        if self._loading:
            return
        self.opt.values["fps_limit"] = v
        self.changed()

    def _on_limit_spin(self, *_):
        if self._loading:
            return
        v = str(int(round(self.limit_adj.get_value())))
        if v != limit_value(self.opt.values.get("fps_limit", "0")):
            self.opt.values["fps_limit"] = v
            self.changed()

    def _pick_mode(self, v):
        if self._loading:
            return
        self.opt.mode = v
        self.changed()

    def _on_hud_switch(self, *_):
        if self._loading:
            return
        on = self.hud_switch.get_active()
        if on != (self.opt.hud > 0):
            self.opt.hud = 2 if on else 0
            self.changed()

