class _PlainAdw:
    """libadwaita with its rows and toasts in plain text, like _Compat: their
    titles and subtitles are Pango markup by default, and the panel puts game,
    window and GPU names and error messages there (« Command & Conquer », a
    path with "<": a parse error, the whole text vanished)."""

    def __init__(self, adw):
        self._adw = adw
        # Factories, not subclasses: AdwSwitchRow and others are final types.
        # The texts go in after use-markup (given together, the title was
        # parsed first).
        def plain(cls, title="", subtitle="", **kw):
            row = cls(use_markup=False, **kw)
            row.set_title(title)
            row.set_subtitle(subtitle)
            return row
        for name in ("ActionRow", "SwitchRow", "ComboRow", "SpinRow", "ExpanderRow"):
            setattr(self, name, lambda _cls=getattr(adw, name), **kw: plain(_cls, **kw))
        # AdwEntryRow's floating title reads markup whatever use-markup says.
        self.EntryRow = lambda title="", **kw: adw.EntryRow(title=GLib.markup_escape_text(title), **kw)
        self.Toast = type("Toast", (), {"new": staticmethod(lambda text: adw.Toast(title=text, use_markup=False))})

    def __getattr__(self, name):
        return getattr(self._adw, name)


