pkgbase = chuds-fg-git
	pkgdesc = Frame generation for Vulkan games (optical flow, x2 to x8) as a Vulkan layer, with a GTK control panel
	pkgver = 0.5.6.r0.g0000000
	pkgrel = 1
	url = https://github.com/Bdexez/Chuds_fg
	arch = x86_64
	arch = aarch64
	license = LicenseRef-proprietary
	makedepends = git
	makedepends = cmake
	makedepends = shaderc
	makedepends = vulkan-headers
	depends = glibc
	depends = vulkan-icd-loader
	optdepends = python-gobject: control panel (chuds-fg-gui)
	optdepends = gtk4: control panel (chuds-fg-gui)
	optdepends = libadwaita: control panel with Adwaita widgets (plain GTK 4 without it)
	optdepends = lib32-vulkan-icd-loader: 32-bit games
	optdepends = vulkan-tools: chuds-fg --check and --report
	provides = chuds-fg
	conflicts = chuds-fg
	conflicts = chuds-fg-bin
	source = chuds-fg-git::git+https://github.com/Bdexez/Chuds_fg.git
	sha256sums = SKIP
	makedepends_x86_64 = lib32-glibc
	makedepends_x86_64 = lib32-gcc-libs

pkgname = chuds-fg-git
